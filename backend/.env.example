# Gleaner model config — any LiteLLM-supported vendor works.
# The coordinator (Gleaner) runs on a bigger model; the simulated actors
# (donors, volunteers, pantries) run on a smaller one.
GLEANER_MODEL=openrouter/openai/gpt-oss-120b
GLEANER_ACTOR_MODEL=openrouter/openai/gpt-oss-20b
OPENROUTER_API_KEY=

# Optional web research for food-safety leverage (degrades gracefully)
TAVILY_API_KEY=
